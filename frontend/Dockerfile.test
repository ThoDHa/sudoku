# Test image for `make test-unit`. Distinct from the production
# frontend/Dockerfile, which ends on nginx:alpine with no node at runtime.
# Build context is frontend/ (see Makefile test-unit target), so COPY paths
# are relative to frontend/, not to the repo root.
# Digest-pinned so the floating 24.x line cannot shift under us; renovate
# proposes digest bumps under review. Matches frontend/Dockerfile's build stage.
FROM node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd
WORKDIR /app
COPY package*.json .npmrc ./
RUN npm ci
COPY . .
# Make write targets world-writable so the container can run as an arbitrary
# host UID/GID (Makefile passes --user $(id -u):$(id -g)). /app is root-owned
# after COPY; without this, vite cannot write its config timestamp files and
# transform cache, which would break the run as a non-root user.
RUN chmod 777 /app && mkdir -p node_modules/.vite && chmod 777 node_modules/.vite
CMD ["npm", "run", "test:unit"]
