{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest", "node"],
    "noEmit": true
  },
  // Override base exclude: tsconfig.json excludes test files for production
  // builds, and that exclude is inherited (not replaced) by include here,
  // which would silently shadow every input this config targets (TS18003).
  "exclude": [],
  "include": [
    "src/**/*.d.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.e2e.ts",
    "src/**/*.e2e.tsx",
    "test/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
