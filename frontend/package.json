{
  "name": "sudoku",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "dup-check": "jscpd src/",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test e2e/integration/",
    "test:e2e:slow": "playwright test e2e/slow/",
    "test:coverage": "vitest run --coverage",
    "test:memory": "playwright test e2e/profiling/ --workers=1 --project=chrome-desktop && playwright test e2e/profiling/ --workers=1 --project=pixel-5 && playwright test e2e/profiling/ --workers=1 --project=iphone-12",
    "simulate": "tsx e2e/simulation/cli.ts",
    "simulate:quick": "tsx e2e/simulation/cli.ts --users 5 --games-per-user 10",
    "allure:generate": "allure generate allure-results -o allure-report --clean",
    "allure:serve": "allure serve allure-results",
    "allure:open": "allure open allure-report",
    "allure:clean": "rm -rf allure-results allure-report",
    "mutation": "stryker run",
    "mutation:incremental": "stryker run --incremental",
    "prepare": "husky install .husky",
    "gen:portal-themes": "tsx scripts/gen-portal-themes.mjs > ../.github/scripts/report_portal.themes.css",
    "gen:go-coverage": "node scripts/lcov-to-istanbul.mjs",
    "gen:go-mutation": "node scripts/go-mutesting-to-stryker.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.1.1",
    "@tailwindcss/postcss": "^4.1.18",
    "loglevel": "^1.9.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@stryker-mutator/core": "~9.6",
    "@stryker-mutator/vitest-runner": "~9.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.3",
    "allure-vitest": "^3.4.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-sonarjs": "^4.1.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.11",
    "jsdom": "^29.1.1",
    "playwright": "^1.57.0",
    "postcss": "^8.4.33",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0"
  }
}
