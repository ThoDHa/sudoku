#!/bin/sh
# Pre-commit hook: ESLint enforces the shared max-warnings 13 budget;
# golangci-lint enforces zero warnings.

echo "Running pre-commit linters..."

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check if Go constants file is staged, and regenerate TypeScript constants if so
if echo "$STAGED_FILES" | grep -q "api/pkg/constants/constants.go"; then
  echo ""
  echo "Go constants file changed - regenerating TypeScript constants..."
  cd api/scripts && go run generate-ts-constants.go
  cd ../..
  echo "✅ TypeScript constants regenerated!"

  # Add the generated file to staging if it exists
  if [ -f "frontend/src/lib/constants-generated.ts" ]; then
    git add frontend/src/lib/constants-generated.ts
    echo "✅ Generated constants file staged for commit"
  fi
fi

# Check for frontend files (.ts, .tsx, .js, .jsx), excluding e2e directory and test files
# Test files are ignored by ESLint config, so we exclude them here too
FRONTEND_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' | grep -v 'e2e/' | grep -v '\.test\.' | grep -v '\.spec\.' || true)

# Check for Go files (.go), excluding WASM files (require WASM build environment)
GO_FILES=$(echo "$STAGED_FILES" | grep -E '\.go$' | grep -v 'cmd/wasm/' || true)

# Run ESLint if frontend files are staged
if [ -n "$FRONTEND_FILES" ]; then
  echo ""
  echo "Running ESLint on staged frontend files..."
  cd frontend

  # Run ESLint with the shared warning budget (max-warnings=13) on staged files.
  # Exits non-zero if warnings exceed the budget or any error is reported.
  if ! npx eslint $(echo "$FRONTEND_FILES" | sed 's|^frontend/||') --max-warnings 13; then
    echo ""
    echo "❌ ESLint found warnings or errors in staged files!"
    echo ""
    echo "Fix the issues above, or use 'git commit --no-verify' to bypass (not recommended)."
    echo ""
    echo "You can run 'cd frontend && npm run lint:fix' to auto-fix some issues."
    exit 1
  fi

  cd ..
  echo "✅ ESLint passed!"
fi

 # Run golangci-lint if Go files are staged
 if [ -n "$GO_FILES" ]; then
   echo ""
   echo "Running golangci-lint on staged Go files..."

   # Convert individual files to package paths for proper type checking
   # golangci-lint needs package paths (with ...) not individual files
   GO_PACKAGES=$(echo "$GO_FILES" | sed 's|^api/||' | sed 's|/[^/]*$|/...|' | sort -u)

   # Run golangci-lint on package paths
   # golangci-lint will exit with non-zero if any issues are found
   if ! (cd api && $(go env GOPATH)/bin/golangci-lint run $GO_PACKAGES); then
     echo ""
     echo "❌ golangci-lint found issues in staged files!"
     echo ""
     echo "Fix the issues above, or use 'git commit --no-verify' to bypass (not recommended)."
     exit 1
   fi

   echo "✅ golangci-lint passed!"
 fi

# Run Prettier format check on staged frontend source files.
# Includes test files: Prettier formats them, unlike ESLint (which ignores them).
PRETTIER_FILES=$(echo "$STAGED_FILES" | grep -E '^frontend/src/.*\.(ts|tsx|css)$' || true)
if [ -n "$PRETTIER_FILES" ]; then
  echo ""
  echo "Running Prettier format check on staged frontend files..."
  cd frontend
  if ! npx prettier --check $(echo "$PRETTIER_FILES" | sed 's|^frontend/||'); then
    echo ""
    echo "❌ Prettier found formatting drift in staged files!"
    echo ""
    echo "Run 'make format-frontend' to fix, then re-stage."
    exit 1
  fi
  cd ..
  echo "✅ Prettier format check passed!"
fi

# Run gofmt check on staged Go files (fast pre-check alongside golangci-lint)
if [ -n "$GO_FILES" ]; then
  echo ""
  echo "Running gofmt check on staged Go files..."
  GOFMT_OUT=$(gofmt -l $(echo "$GO_FILES"))
  if [ -n "$GOFMT_OUT" ]; then
    echo "$GOFMT_OUT"
    echo ""
    echo "❌ gofmt found formatting drift in staged files!"
    echo ""
    echo "Run 'make format-go' to fix, then re-stage."
    exit 1
  fi
  echo "✅ gofmt check passed!"
fi

# If no relevant files were staged, just pass
if [ -z "$FRONTEND_FILES" ] && [ -z "$GO_FILES" ]; then
  echo "No linterable files staged. Skipping linter checks."
fi

echo ""
echo "✅ All linter checks passed!"
exit 0
