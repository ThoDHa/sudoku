.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Vite files
.vite/
node_modules/.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Debug and log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Go specific
# Compiled Go test binaries (e.g. api/<pkg>/<pkg>.test). Scoped to api/ where
# all Go sources live, so it never swallows unrelated .test files.
api/**/*.test
*.out

# Go workspace file
go.work
go.work.sum

# Code coverage profiles and other test artifacts
coverage.*
profile.cov
frontend/coverage/

# Python cache (for debug scripts)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# OpenCode task management
.opencode/

